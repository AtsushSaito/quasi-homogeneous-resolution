-- qh.m2 -- computational checks of statement M of docs/MATH.md
--   (resolution of quasi-homogeneous isolated singularities in positive characteristic)
--
--   L0 qhReport(f, w)      Q1, A4, p|w_i, p|d, convenience, Newton non-degeneracy, strata
--   P  qhPredict(f, w)     predicted local types of X' at each stratum, HJ chains, genus of Y,
--                          central self-intersection, predicted dual graph (surfaces)
--   L2 toricResolve(f, w)  ambient toric resolution of Bl_w A^n, strict transform smoothness,
--                          exceptional components, intersection matrix (surfaces)
--   qhVerify(f, w)         runs everything and compares prediction with computation
--
-- This file does not use Bergh's destackification (that is package/ToricDestackification.m2, used by
-- src/bergh_local.m2).  L2 is an independent route: toric resolution of the ambient weighted
-- blow-up.  For Newton non-degenerate f over a perfect field it is what Aroca-Gomez-Morales-Mourtada,
-- Thm 1.3, leads one to expect (that theorem asks for a subdivision compatible with the Groebner fan
-- of f, which is NOT checked here).  The code does not rely on it: smoothness of the strict transform,
-- properness and the isomorphism off the vertex are verified directly for every example.

needsPackage "NormalToricVarieties";
needsPackage "Polyhedra";

-- ------------------------------------------------------------------ utilities

wdegOf = (e, w) -> sum apply(#w, i -> e#i * w#i);
gcdList = L -> fold(L, gcd);
banner = s -> (<< endl << "==== " << s << " ====" << endl);

-- minimal generating monomials of k[A]^{mu_r}, mu_r acting diagonally with weights c (mod r).
-- Valid in every characteristic (mu_r-invariants = weight-0 part of the Z/r-grading).
-- Generators have degree <= r (pigeonhole on prefix sums), so degrees 1..r suffice.
muInvariantMonomials = (c, r, A) -> (
    m := numgens A; gensL := {};
    for dd from 1 to r do for mono in flatten entries basis(dd, A) do (
        e := first exponents mono;
        if sum(apply(m, j -> c#j * e#j)) % r != 0 then continue;
        if any(gensL, g -> mono % g == 0) then continue;
        gensL = append(gensL, mono));
    gensL)

removeOne = (L, v) -> (k := position(L, a -> a == v); if k === null then error("removeOne: value absent"); drop(L, {k, k}))

-- Hirzebruch-Jung continued fraction r/q = [b1,...,bk]
hjChain = (r, q) -> (
    L := {}; rr := r; qq := q;
    while qq != 0 do (b := ceiling(rr / qq); L = append(L, b); (rr, qq) = (qq, b*qq - rr));
    L)

-- cyclic quotient surface singularity 1/r(a,b): remove pseudo-reflections, normalise to 1/r'(1,q).
-- returns (r', q); r' = 1 means smooth.
cyclicType2 = (r, a, b) -> (
    rr := r; aa := a % r; bb := b % r;
    if rr == 1 then return (1, 0);
    -- reduce common factors with r alternately
    changed := true;
    while changed do (
        changed = false;
        g := gcd(rr, aa);
        if g > 1 then (rr = rr // g; aa = aa // g; aa = aa % rr; bb = bb % rr; changed = true);
        if rr == 1 then return (1, 0);
        g = gcd(rr, bb);
        if g > 1 then (rr = rr // g; bb = bb // g; aa = aa % rr; bb = bb % rr; changed = true);
        if rr == 1 then return (1, 0));
    -- now gcd(aa, rr) = gcd(bb, rr) = 1
    ainv := 1; for t from 1 to rr - 1 do if (aa * t) % rr == 1 then ainv = t;
    q := (bb * ainv) % rr;
    (rr, q))

-- general cyclic type 1/r(a_1..a_m): order of the subgroup generated by pseudo-reflections
-- (elements fixing all but one coordinate); quotient is smooth iff it equals r.
reflectionSubgroupOrder = (r, a) -> (
    m := #a;
    gs := apply(m, j -> gcdList(append(apply(select(toList(0..m-1), k -> k != j), k -> a#k % r), r)));
    fold(gs, lcm))

-- ------------------------------------------------------------------ L0

-- Every initial form In_v(f) for v in the closed orthant, enumerated exactly.
--
-- Newton non-degeneracy, in the form the citable theorem needs (Aroca, Gomez-Morales, Mourtada,
-- Beitr. Algebra Geom. 2023, Definition 1.2), asks that Sing(V(In_v(f))) meet the torus for NO
-- v in sigma.  The distinct argmin sets are indexed by the faces of the Newton polyhedron
-- Gamma_+, and every face is an intersection of facets, so taking v to be the sum of a subset of
-- the facet inner normals realises them all.
--
-- The earlier test here restricted f to coordinate subspaces instead.  That is strictly coarser:
-- for f = x^2 y + y^2 z + z^2 x the polyhedron has seven faces and only four of them arise by
-- setting variables to zero, so the three edge faces were never examined.
initialForms = f -> (
    R := ring f;
    n := numgens R;
    lf := listForm f;
    es := apply(lf, pr -> pr#0);
    if #es == 1 then return {f};
    Gp := (convexHull transpose matrix es) + posHull id_(ZZ^n);
    (A, b) := halfspaces Gp;                          -- M2's convention is A x <= b
    nrm := select(entries(-A), v -> all(v, c -> c >= 0));
    out := new MutableHashTable;
    for S in subsets nrm do (
        v := if #S == 0 then toList(n:0) else fold(S, (a,c) -> apply(a, c, plus));
        vals := apply(es, e -> sum apply(n, i -> v#i * e#i));
        m := min vals;
        out#(sort select(toList(0..#es-1), j -> vals#j == m)) = true);
    apply(sort keys out, key -> sum apply(key, j ->
        (lf#j)#1 * product apply(n, i -> R_i^(((lf#j)#0)#i)))));

qhReport = method();
qhReport (RingElement, List) := (f, w) -> (
    R := ring f; p := char R; n := numgens R;
    lf := listForm f;
    degs := unique apply(lf, pr -> wdegOf(pr#0, w));
    if #degs != 1 then error("Q1 fails: monomials of f have weighted degrees " | toString degs);
    d := first degs;
    banner "L0: quasi-homogeneity and isolatedness";
    << "char k = " << p << ",  n = " << n << ",  f = " << f << endl;
    << "weights w = " << w << ",  degree d = " << d << endl;
    << "p | w_i for i in " << select(toList(0..n-1), i -> w#i % p == 0) << "    p | d : " << (d % p == 0) << endl;
    J := ideal f + ideal jacobian f;
    dimSing := dim J; a4 := dimSing <= 0;
    << "Sing(X) = V(f, df) has dimension " << dimSing << "  ->  A4 (isolated) : " << (if a4 then "OK" else "FAIL") << endl;
    conv := all(n, i -> any(lf, pr -> (e := pr#0; e#i > 0 and all(n, j -> j == i or e#j == 0))));
    << "convenient (pure power of every variable present): " << conv << endl;
    -- Newton non-degeneracy in the sense the citable theorem needs: for EVERY v in the closed
    -- orthant, the initial form In_v(f) has no singular point on the torus.
    ifs := initialForms f;
    nondeg := true;
    for g in ifs do (
        IJ := ideal g + ideal apply(n, i -> diff(R_i, g));
        if saturate(IJ, product gens R) != ideal(1_R) then (
            nondeg = false; << "  degenerate face: In_v(f) = " << g << endl));
    << "Newton non-degenerate: " << nondeg << " (" << #ifs << " initial forms checked)"
       << (if nondeg then "  (L2 expected to work, cf. Aroca-Gomez-Morales-Mourtada Thm 1.3, k perfect; verified directly below)"
           else "  (L2 may fail; not a counterexample to M)") << endl;
    << endl << "Stabilizer strata on Y = Proj R (K = indices of nonzero coordinates):" << endl;
    strata := {};
    for K in subsets(toList(0..n-1)) do (
        if #K == 0 then continue;
        r := gcdList w_K;
        if r == 1 then continue;
        comp := select(toList(0..n-1), i -> not member(i, K));
        IK := ideal f + ideal apply(comp, i -> R_i);
        sat := saturate(IK, product apply(K, i -> R_i));
        if sat == ideal(1_R) then continue;
        dK := dim sat - 1;
        strata = append(strata, new HashTable from {"K" => K, "r" => r, "dim" => dK, "ideal" => sat});
        << "  K = " << K << "  mu_" << r << "  dim in Proj = " << dK << (if r % p == 0 then "   <-- p | r : not etale, tame but not DM" else "") << endl);
    if #strata == 0 then << "  (none)" << endl;
    new HashTable from {"p" => p, "n" => n, "d" => d, "A4" => a4, "convenient" => conv, "nondegenerate" => nondeg, "strata" => strata})

-- ------------------------------------------------------------------ P: prediction

-- weights of the mu_r action on the tangent space of the slice Z x A^1_s at a point of a stratum
-- component P (a prime ideal of R containing the stratum): all coordinates j != i (i in K) with
-- weights w_j mod r, minus the direction j0 with d_j0 f not in P, plus s with weight -1.
qhPredict = method();
qhPredict (RingElement, List, HashTable) := (f, w, rep) -> (
    R := ring f; p := char R; n := numgens R; d := rep#"d";
    banner "P: predicted local structure of X' (from tangent weights)";
    preds := {};
    -- Reasons the prediction below is not trustworthy.  Anything collected here must stop the
    -- verdict from being read as agreement or disagreement: a prediction built on a guess that
    -- happens to match is not evidence, and one that fails to match is not a counterexample.
    unsound := {};
    for st in rep#"strata" do (
        K := st#"K"; r := st#"r"; i := first K;
        comps := decompose st#"ideal";
        for P in comps do (
            -- residue degree of the point(s) on the slice x_i = 1
            -- the slice x_i = 1 meets the orbit of a point of Y in a mu_{w_i/r}-torsor over its
            -- residue field (non-reduced when p | w_i/r), so the residue degree on Y is
            -- degree(slice fibre) * r / w_i.
            Pslice := P + ideal(R_i - 1);
            -- The formula is an exact identity, so a non-exact quotient means its hypothesis
            -- failed; floor division would hide that.
            if dim Pslice == 0 and ((degree Pslice) * r) % (w#i) != 0 then
                unsound = append(unsound, "residue degree " | toString((degree Pslice) * r)
                    | "/" | toString(w#i) | " is not an integer at " | toString P);
            dP := if dim Pslice == 0 then (degree Pslice) * r // (w#i) else -1;   -- -1: positive-dimensional stratum
            js := select(toList(0..n-1), j -> (diff(R_j, f)) % P != 0);
            if #js == 0 then (<< "  WARNING: all partials vanish on " << P << endl; continue);
            wjs := unique apply(js, j -> w#j % r);
            -- Everything below (tw, the cyclic type, the HJ chain) depends on which j0 is taken,
            -- so an inconsistent weight multiset makes the choice arbitrary.
            if #wjs != 1 then (
                << "  WARNING: inconsistent weights of df on " << P << " : " << wjs << endl;
                unsound = append(unsound, "weights of df disagree on " | toString P | " : " | toString wjs));
            j0 := first js;
            -- T_P(stack) = ker(df) / (orbit direction): all n weights, minus the weight of the
            -- df-direction, minus one weight 0 (orbit; the reduced Euler field has weight 0),
            -- plus the fibre coordinate s of weight -1.
            tw := removeOne(removeOne(apply(n, j -> w#j % r), w#j0 % r), 0);
            tw = append(tw, (-1) % r);
            info := new MutableHashTable from {"K" => K, "r" => r, "P" => P, "deg" => dP, "weights" => tw};
            if n == 3 then (
                (rr, q) := cyclicType2(r, tw#0, tw#1);
                chain := if rr == 1 then {} else hjChain(rr, q);
                info#"type" = (rr, q); info#"chain" = chain;
                << "  K = " << K << "  mu_" << r << "  point(s) " << P << "  residue deg " << dP
                   << "  tangent weights " << tw << "  ->  1/" << rr << "(1," << q << ")  HJ chain " << chain << endl)
            else (
                h := reflectionSubgroupOrder(r, tw);
                info#"smooth" = (h == r);
                << "  K = " << K << "  mu_" << r << "  component " << P << (if dP >= 0 then ("  residue deg " | toString dP) else "  (positive-dimensional)")
                   << "  tangent weights " << tw << "  ->  " << (if h == r then "smooth point of X'" else ("quotient singularity 1/" | toString r | toString tw)) << endl);
            preds = append(preds, new HashTable from info)));
    -- genus of the central curve / a-invariant, and central self-intersection for surfaces
    a := d - sum w;
    Rw := (coefficientRing R)(monoid [apply(gens R, baseName), Degrees => w]);
    g := if a < 0 then 0 else hilbertFunction(a, Rw / ideal sub(f, Rw));
    result := new MutableHashTable from {"strata" => preds, "a" => a};
    if n == 3 then (
        degD := d / product w;
        arms := select(preds, q -> #q#"chain" > 0);
        -- "deg" is -1 when the stratum component is positive dimensional.  Below it is used as a
        -- multiplicity: in sumBeta, in nCurves, and in toList(deg : chain), where M2 quietly
        -- returns {} for a negative count and the arm vanishes from the prediction.
        if any(arms, q -> q#"deg" < 0) then
            unsound = append(unsound, "an arm sits on a positive-dimensional stratum, so its multiplicity is unknown");
        sumBeta := sum apply(arms, q -> (q#"deg") * ((q#"type")#1) / ((q#"type")#0));
        -- convention: for chain r/q = [b1..bk] the arm contributes beta/alpha = q/r ... see below
        b := degD + sumBeta;
        nCurves := 1 + sum apply(arms, q -> (q#"deg") * #(q#"chain"));
        result#"genusY" = g; result#"b" = b; result#"nCurves" = nCurves;
        result#"arms" = apply(arms, q -> (q#"deg", q#"chain"));
        << endl << "predicted: central curve Y of genus " << g << " with Y^2 = -" << b
           << ",  arms " << apply(arms, q -> (q#"deg", q#"chain")) << ",  total exceptional curves " << nCurves << endl;
        if b != floor b then (
            << "  WARNING: predicted Y^2 is not an integer -- convention or prediction error" << endl;
            unsound = append(unsound, "predicted Y^2 = -" | toString b | " is not an integer")));
    result#"unsound" = unsound;
    if #unsound > 0 then
        << endl << "  PREDICTION NOT SOUND: " << concatenate between("; ", unsound) << endl;
    new HashTable from result)

-- ------------------------------------------------------------------ L2: toric resolution

-- substitute variables of ring(g) by Laurent monomials nums_j / dens_j of ring T, clearing denominators
laurentSub = (g, T, nums, dens) -> (
    S := ring g; m := numgens S; lf := listForm g;
    mx := apply(m, j -> max apply(lf, pr -> (pr#0)#j));
    sum apply(lf, pr -> (e := pr#0; promote(pr#1, T) * product(m, j -> (nums#j)^(e#j) * (dens#j)^(mx#j - e#j)))))

-- exponent matrix E = V_target * V_source^{-1}: source chart coordinate y_j = prod_k (target y_k)^(E_kj)
chartChange = (Vsource, Vtarget) -> (
    Ms := matrix Vsource; Mt := matrix Vtarget;
    E := Mt * inverse(Ms ** QQ);
    matrix apply(numRows E, a -> apply(numColumns E, b -> lift(E_(a,b), ZZ))))

-- transport an ideal Q (in chart ring Yr, coordinates of cone sigmaS) to the coordinates of cone sigmaT,
-- as the closure of its part meeting the torus of the divisor of ray v (present in both cones).
-- Assumes Q contains y_{pos_S(v)}.
transportIdeal = (Q, Yr, rayList, sigmaS, sigmaT, v) -> (
    n := numgens Yr;
    E := chartChange(rayList_sigmaS, rayList_sigmaT);    -- y^S_j = prod_k (y^T_k)^(E_kj)
    nums := apply(n, j -> product(n, k -> if E_(k,j) > 0 then Yr_k^(E_(k,j)) else 1_Yr));
    dens := apply(n, j -> product(n, k -> if E_(k,j) < 0 then Yr_k^(-E_(k,j)) else 1_Yr));
    posT := position(sigmaT, a -> a == v);
    gensQ := select(flatten entries gens Q, g -> g != 0);
    I := ideal apply(gensQ, g -> laurentSub(g, Yr, nums, dens)) + ideal Yr_posT;
    others := product(select(toList(0..n-1), k -> k != posT), k -> Yr_k);
    saturate(I, others))

-- number of points (with length) of the 0-dimensional ideal I in the chart of cone sigma, counting a
-- point only in the first maximal cone (in coneList order) containing the orbit it lies on.
countPoints = (I, Yr, sigma, coneList) -> (
    -- N(tau) = length of the part of V(I) lying in U_tau = {y_j != 0 for j not in tau}
    -- (saturation keeps multiplicities); exact(tau) = N(tau) - sum_{tau' strictly in tau} exact(tau').
    n := numgens Yr; total := 0;
    exact := new MutableHashTable;
    taus := sort(subsets(toList(0..n-1)), t -> #t);
    for tau in taus do (
        others := product(select(toList(0..n-1), j -> not member(j, tau)), j -> Yr_j);
        Isat := saturate(I, others);
        if Isat != ideal 1_Yr and dim Isat > 0 then error "countPoints: positive-dimensional intersection";
        Ntau := if Isat == ideal 1_Yr then 0 else degree Isat;
        ex := Ntau - sum apply(select(taus, t -> #t < #tau and isSubset(t, tau)), t -> exact#t);
        exact#tau = ex;
        rayset := sigma_tau;
        firstCone := position(coneList, c -> isSubset(rayset, c));
        if coneList#firstCone === sigma then total = total + ex);
    total)

toricResolve = method(Options => {Verbose => true});
toricResolve (RingElement, List) := opts -> (f, w) -> (
    R := ring f; kk := coefficientRing R; n := numgens R;
    banner "L2: toric resolution of the ambient weighted blow-up";
    X1 := toricBlowup(toList(0..n-1), affineSpace n, w);
    t0 := currentTime();
    X2 := makeSmooth X1;
    rayList := rays X2; coneList := max X2;
    << "fan: " << #rayList << " rays, " << #coneList << " maximal cones, smooth = " << isSmooth X2 << "  (" << currentTime() - t0 << " s)" << endl;
    if not isSmooth X2 then error "makeSmooth failed";
    isExc := v -> all(v, c -> c > 0);
    basisVecs := entries id_(ZZ^n);
    bad := select(toList(0..#rayList-1), j -> not isExc rayList#j and not member(rayList#j, basisVecs));
    << "T -> A^n is an isomorphism away from the origin : " << (#bad == 0) << endl;
    -- Exact combinatorics, not sampling.  checkRefinesOrthant counts random interior points and
    -- calls a multiply-covered point benign, so two maximal cones overlapping in a full
    -- dimensional region -- the very failure this is meant to catch -- would pass it.
    (proper, properNotes) := refinesOrthantExact(rayList, coneList);
    << "T -> A^n is proper (the fan refines the orthant) : " << proper << endl;
    if not proper then for t in properNotes do << "    " << t << endl;
    Yr := kk[apply(n, j -> (getSymbol "yy")_j)];
    -- strict transform in every chart
    ftOf := new MutableHashTable;
    allSmooth := true; badCharts := {};
    for sigma in coneList do (
        V := rayList_sigma;
        g := sub(f, matrix{ apply(n, i -> product(n, j -> Yr_j^(V#j#i))) });
        ex := exponents g;
        mono := product(n, j -> Yr_j^(min apply(ex, e -> e#j)));
        ft := g // mono; assert(ft * mono == g);
        ftOf#sigma = ft;
        if dim(ideal ft + ideal jacobian ft) >= 0 then (allSmooth = false; badCharts = append(badCharts, (sigma, ft))));
    << "strict transform smooth in all " << #coneList << " charts : " << allSmooth << endl;
    for b in badCharts do << "  singular chart cone " << b#0 << " : " << b#1 << endl;
    -- exceptional divisors meeting the strict transform
    excRays := select(toList(0..#rayList-1), j -> isExc rayList#j);
    meets := select(excRays, v -> any(coneList, sigma -> member(v, sigma) and (dim(ideal ftOf#sigma + ideal Yr_(position(sigma, a -> a == v))) >= 0)));
    << "exceptional divisors meeting the strict transform: " << #meets << "  rays " << apply(meets, j -> rayList#j) << endl;
    result := new MutableHashTable from {"allSmooth" => allSmooth, "charts" => #coneList, "meets" => meets,
        "rays" => rayList, "proper" => proper, "isoOffVertex" => (#bad == 0)};
    if n != 3 or not allSmooth then return new HashTable from result;
    -- ---- surfaces: components of every D_u meeting X~, multiplicities, intersection numbers
    -- A component is either torus-visible (an irreducible factor of ft|_{y_u=0} meeting the torus of
    -- D_u) or a torus-invariant curve V(u,u') contained in X~ (order of ft|_{y_u=0} along y_{u'} > 0).
    -- Multiplicities m^u_C of C in the Cartier divisor D_u|_{X~} are the factor / order exponents.
    monoOrder := (h, j) -> min apply(exponents h, e -> e#j);
    allRays := toList(0..#rayList-1);
    comps := {};                       -- MutableHashTables: id, cont (ray => mult), ideals (cone => ideal), exc, kind
    boundaryDone := new MutableHashTable;
    for u in allRays do (
        conesU := select(coneList, sigma -> member(u, sigma));
        if not any(conesU, sigma -> dim(ideal ftOf#sigma + ideal Yr_(position(sigma, a -> a == u))) >= 0) then continue;
        sigma0 := first conesU; pu := position(sigma0, a -> a == u);
        h := sub(ftOf#sigma0, {Yr_pu => 0});
        if h == 0 then (<< "  WARNING: strict transform contains the whole divisor D_" << u << endl; continue);
        -- torus-visible components
        hred := h // product(n, j -> Yr_j^(monoOrder(h, j)));
        for t in toList factor hred do (
            q := t#0; m := t#1;
            if ring q =!= Yr or first degree q == 0 then continue;   -- constant factor (e.g. -1)
            Q := ideal q + ideal Yr_pu;
            ideals := new MutableHashTable; ideals#sigma0 = Q;
            for sigma in conesU do if sigma =!= sigma0 then ideals#sigma = transportIdeal(Q, Yr, rayList, sigma0, sigma, u);
            comps = append(comps, new MutableHashTable from {"id" => (u, q), "kind" => "torus", "u" => u, "sigma0" => sigma0, "h" => q,
                "cont" => new HashTable from {u => m}, "ideals" => ideals, "exc" => isExc rayList#u}));
        -- boundary components V(u, u') for rays u' adjacent to u
        adj := unique flatten apply(conesU, sigma -> select(sigma, a -> a != u));
        for up in adj do (
            key := sort {u, up};
            if boundaryDone#?key then continue;
            sigma := first select(conesU, c -> member(up, c));
            pu2 := position(sigma, a -> a == u); pup := position(sigma, a -> a == up);
            hu := sub(ftOf#sigma, {Yr_pu2 => 0});
            if hu == 0 then continue;
            mu := monoOrder(hu, pup);
            if mu == 0 then continue;
            hup := sub(ftOf#sigma, {Yr_pup => 0});
            mup := monoOrder(hup, pu2);
            boundaryDone#key = true;
            ideals := new MutableHashTable;
            for c in coneList do if member(u, c) and member(up, c) then ideals#c = ideal(Yr_(position(c, a -> a == u)), Yr_(position(c, a -> a == up)));
            comps = append(comps, new MutableHashTable from {"id" => key, "kind" => "boundary", "u" => u, "up" => up,
                "cont" => new HashTable from {u => mu, up => mup}, "ideals" => ideals, "exc" => (isExc rayList#u or isExc rayList#up)})));
    Nall := #comps;
    excIdx := select(toList(0..Nall-1), a -> (comps#a)#"exc");
    << "curve components of the divisors D_u meeting the strict transform: " << Nall << "  (exceptional: " << #excIdx << ")" << endl;
    idealIn := (c, sigma) -> if (c#"ideals")#?sigma then (c#"ideals")#sigma else ideal 1_Yr;
    -- genus / smoothness of the plane model (torus-visible components only)
    for c in comps do (
        if c#"kind" == "boundary" then (c#"pa" = 0; c#"closureSmooth" = true; continue);
        q := c#"h"; pu := position(c#"sigma0", a -> a == c#"u");
        others := select(toList(0..n-1), j -> j != pu);
        P2 := kk[apply(others, j -> Yr_j), getSymbol "t"];
        q2 := sub(q, P2);
        D := first degree q2;
        qh := sum apply(listForm q2, pr -> (e := pr#0; promote(pr#1, P2) * P2_0^(e#0) * P2_1^(e#1) * P2_2^(D - e#0 - e#1)));
        c#"pa" = genus ideal qh;
        c#"closureSmooth" = (dim(ideal qh + ideal jacobian qh) <= 0));
    -- pairwise intersection numbers (all components)
    M := mutableMatrix(ZZ, Nall, Nall);
    for a from 0 to Nall-1 do for b from a+1 to Nall-1 do (
        ca := comps#a; cb := comps#b; total := 0;
        need := unique(keys ca#"cont" | keys cb#"cont");
        for sigma in coneList do (
            if not all(need, r -> member(r, sigma)) then continue;
            total = total + countPoints(idealIn(ca, sigma) + idealIn(cb, sigma), Yr, sigma, coneList));
        M_(a,b) = total; M_(b,a) = total);
    -- self-intersections from div(x_i)|_{X~} = sum_u <e_i,u> D_u|_{X~},  i = 0..n-1 (consistency check)
    for a from 0 to Nall-1 do (
        ca := comps#a; cont := ca#"cont"; vals := {};
        if not ca#"exc" then (ca#"self" = null; continue);   -- non-compact: self-intersection undefined
        for i from 0 to n-1 do (
            coef := sum apply(keys cont, u -> (rayList#u)#i * cont#u);
            if coef == 0 then continue;
            S := 0;
            for u in allRays do (
                ui := (rayList#u)#i;
                if ui == 0 then continue;
                if cont#?u then (
                    for b from 0 to Nall-1 do if b != a and ((comps#b)#"cont")#?u then S = S + ui * ((comps#b)#"cont")#u * M_(a,b))
                else (
                    du := 0;
                    for sigma in coneList do (
                        if not (member(u, sigma) and all(keys cont, r -> member(r, sigma))) then continue;
                        du = du + countPoints(idealIn(ca, sigma) + ideal Yr_(position(sigma, x -> x == u)) + ideal ftOf#sigma, Yr, sigma, coneList));
                    S = S + ui * du));
            vals = append(vals, - S / coef));
        if #unique vals != 1 then << "  WARNING: inconsistent self-intersection for component " << a << " : " << vals << endl;
        ca#"self" = first vals;
        if first vals != floor first vals then << "  WARNING: non-integral self-intersection " << first vals << endl
        else M_(a,a) = lift(first vals, ZZ));
    Mz := matrix M;
    excM := submatrix(Mz, excIdx, excIdx);
    N := #excIdx;
    << "exceptional curves:" << endl;
    for a in excIdx do << "  C_" << a << ": " << (if (comps#a)#"kind" == "torus" then ("in D_" | toString rayList#((comps#a)#"u")) else ("V" | toString apply((comps#a)#"id", r -> rayList#r)))
        << (if (comps#a)#"kind" == "torus" and rayList#((comps#a)#"u") == w then " (central Y)" else "")
        << "  mult " << toString values (comps#a)#"cont" << "  p_a " << (comps#a)#"pa" << "  closureSmooth " << (comps#a)#"closureSmooth" << "  self " << (comps#a)#"self" << endl;
    << "intersection matrix of the exceptional curves:" << endl << excM << endl;
    negdef := all(toList(1..N), k -> (det submatrix(-excM, toList(0..k-1), toList(0..k-1))) > 0);
    << "negative definite: " << negdef << endl;
    centres := select(excIdx, a -> (comps#a)#"kind" == "torus" and rayList#((comps#a)#"u") == w);
    arms := {};
    if #centres == 1 then (
        c := first centres;
        nbrs := a -> select(excIdx, b -> b != a and Mz_(a,b) > 0);
        for a0 in nbrs c do (
            chain := {}; prev := c; cur := a0; ok := true;
            while true do (
                chain = append(chain, cur);
                nx := select(nbrs cur, b -> b != prev);
                if #nx == 0 then break;
                if #nx > 1 then (ok = false; break);
                prev = cur; cur = first nx);
            arms = append(arms, (ok, apply(chain, a -> -(comps#a)#"self"), apply(chain, a -> Mz_(c,a)))));
        << "central curve C_" << c << " : self " << (comps#c)#"self" << ", p_a " << (comps#c)#"pa" << endl;
        << "arms from the centre (chain?, -self-intersections, intersection with centre): " << arms << endl)
    else << "central divisor has " << #centres << " components; no star analysis" << endl;
    result#"N" = N; result#"matrix" = excM; result#"negdef" = negdef; result#"arms" = arms;
    result#"centre" = if #centres == 1 then (first centres) else null;
    result#"centreSelf" = if #centres == 1 then (comps#(first centres))#"self" else null;
    result#"centrePa" = if #centres == 1 then (comps#(first centres))#"pa" else null;
    new HashTable from result)

-- ------------------------------------------------------------------ driver

qhVerify = method();
qhVerify (RingElement, List) := (f, w) -> (
    R := ring f; p := char R; n := numgens R;
    rep := qhReport(f, w);
    if not rep#"A4" then (<< endl << "A4 fails: M does not apply.  verdict = SKIP" << endl; return new HashTable from {"verdict" => "SKIP", "A4" => false});
    pr := qhPredict(f, w, rep);
    -- extend the field so that all stratum points are rational
    e := 1; for st in pr#"strata" do if st#"deg" > 0 then e = lcm(e, st#"deg");
    ff := f; ww := w;
    if e > 1 and n == 3 then (
        kk2 := GF(p^e); R2 := kk2[apply(gens R, baseName)];
        ff = sub(f, R2);
        << endl << "(strata have points of residue degree up to " << e << ": working over GF(" << p << "^" << e << "))" << endl;
        rep = qhReport(ff, w); pr = qhPredict(ff, w, rep));
    r2 := toricResolve(ff, ww);
    banner "verdict";
    verdict := "CONFIRM"; notes := {};
    -- An unsound prediction must not be reported as agreement or as disagreement.
    if #(pr#"unsound") > 0 then (verdict = "PREDICT-FAIL"; notes = notes | pr#"unsound");
    if not r2#"allSmooth" then (verdict = "TORIC-FAIL"; notes = append(notes, "strict transform not smooth in some chart"));
    if r2#?"proper" and not r2#"proper" then (verdict = "MISMATCH"; notes = append(notes, "fan does not refine the orthant: X~ -> X not proven proper"));
    if r2#?"isoOffVertex" and not r2#"isoOffVertex" then (verdict = "MISMATCH"; notes = append(notes, "an added ray is not interior: not an isomorphism off the vertex"));
    if n == 3 and r2#"allSmooth" and #(pr#"unsound") == 0 then (
        if r2#"N" != pr#"nCurves" then (verdict = "MISMATCH"; notes = append(notes, "curve count " | toString r2#"N" | " vs predicted " | toString pr#"nCurves"));
        if r2#"centre" === null then (verdict = "MISMATCH"; notes = append(notes, "central divisor not irreducible"))
        else (
            if r2#"centreSelf" != -(pr#"b") then (verdict = "MISMATCH"; notes = append(notes, "Y^2 = " | toString r2#"centreSelf" | " vs predicted " | toString(-(pr#"b"))));
            if r2#"centrePa" != pr#"genusY" then notes = append(notes, "p_a(closure of Y) = " | toString r2#"centrePa" | " vs predicted genus " | toString pr#"genusY" | " (closure may be singular)");
            predArms := sort flatten apply(pr#"arms", a -> toList(a#0 : a#1));
            obsArms := sort apply(r2#"arms", a -> a#1);
            if predArms != obsArms then (verdict = "MISMATCH"; notes = append(notes, "arms " | toString obsArms | " vs predicted " | toString predArms));
            if any(r2#"arms", a -> not a#0) then (verdict = "MISMATCH"; notes = append(notes, "an arm is not a chain")));
        if not r2#"negdef" then (verdict = "MISMATCH"; notes = append(notes, "intersection matrix not negative definite")));
    << "verdict: " << verdict << (if #notes > 0 then ("   " | concatenate between("; ", notes)) else "") << endl;
    new HashTable from {"verdict" => verdict, "A4" => true, "nondegenerate" => rep#"nondegenerate", "report" => rep, "predict" => pr, "L2" => r2, "notes" => notes})

-- ------------------------------------------------------------------ L2 over an imperfect field
-- ring f = F_p[a_1..a_m, x_1..x_n]: the first m variables are parameters (k = F_p(a)), weights w on x.
-- Regularity of a k-scheme at points over the generic point of Spec F_p[a] is tested with the extended
-- Jacobian (all partials, including d/da_j): the singular ideal J of the total space meets the generic
-- fibre iff J contains no nonzero element of F_p[a]  (image of V(J) is dense iff J cap F_p[a] = 0).
regularOnGenericFibre = (I, m) -> (
    B := ring I; n := numgens B - m;
    J := I + minors(codim I, jacobian I);
    el := eliminate(toList(apply(n, j -> B_(m+j))), J);
    (el != 0, J))

toricResolveRegular = method();
toricResolveRegular (RingElement, List, ZZ) := (f, w, m) -> (
    B := ring f; kk := coefficientRing B; n := numgens B - m;
    banner "L2 (regular mode over F_p(a)): toric resolution of the ambient weighted blow-up";
    -- A4-regular: singular locus of X over the generic fibre
    (reg0, J0) := regularOnGenericFibre(ideal f, m);
    xs := toList(apply(n, j -> B_(m+j)));
    Jsat := saturate(J0, ideal xs);          -- remove the vertex section
    regAway := (eliminate(xs, Jsat) != 0);   -- generic fibre misses the rest of the singular locus
    << "X regular on the generic fibre away from v : " << regAway << endl;
    X2 := makeSmooth toricBlowup(toList(0..n-1), affineSpace n, w);
    rayList := rays X2; coneList := max X2;
    << "fan: " << #rayList << " rays, " << #coneList << " maximal cones" << endl;
    Yr := kk[apply(m, j -> baseName B_j), apply(n, j -> (getSymbol "yy")_j)];
    allReg := true; allSmoothOverK := true; badCharts := {};
    for sigma in coneList do (
        V := rayList_sigma;
        g := sub(f, apply(m, j -> B_j => Yr_j) | apply(n, i -> B_(m+i) => product(n, j -> Yr_(m+j)^(V#j#i))));
        ex := exponents g;
        mono := product(n, j -> Yr_(m+j)^(min apply(ex, e -> e#(m+j))));
        ft := g // mono; assert(ft * mono == g);
        (reg, J) := regularOnGenericFibre(ideal ft, m);
        -- smoothness over k: partials in y only
        Jk := ideal ft + ideal apply(n, j -> diff(Yr_(m+j), ft));
        smoothK := (eliminate(toList(apply(n, j -> Yr_(m+j))), Jk) != 0);
        if not reg then (allReg = false; badCharts = append(badCharts, (sigma, ft)));
        if not smoothK then allSmoothOverK = false);
    << "strict transform REGULAR on the generic fibre in all " << #coneList << " charts : " << allReg << endl;
    << "strict transform SMOOTH over k in all charts : " << allSmoothOverK << endl;
    for b in badCharts do << "  non-regular chart cone " << b#0 << " : " << b#1 << endl;
    new HashTable from {"allRegular" => allReg, "allSmoothOverK" => allSmoothOverK, "charts" => #coneList})

-- ------------------------------------------------------------------ L2 for an ideal (non-hypersurface X)
-- X = V(I) subset A^n, I homogeneous for the weights w.  Strict transform in each chart = saturation of
-- the total transform by the exceptional coordinates.  Smoothness via singularLocus (codim minors).
toricResolveIdeal = method();
toricResolveIdeal (Ideal, List) := (I, w) -> (
    R := ring I; kk := coefficientRing R; n := numgens R;
    banner "L2 (ideal version): toric resolution of the ambient weighted blow-up";
    J := I + minors(codim I, jacobian I);
    << "dim X = " << dim I << ",  Sing(X) dimension " << dim J << "  ->  A4 : " << (dim J <= 0) << endl;
    X2 := makeSmooth toricBlowup(toList(0..n-1), affineSpace n, w);
    rayList := rays X2; coneList := max X2;
    << "fan: " << #rayList << " rays, " << #coneList << " maximal cones" << endl;
    Yr := kk[apply(n, j -> (getSymbol "yy")_j)];
    isExc := v -> all(v, c -> c > 0);
    allSmooth := true; badCharts := {}; excMeet := new MutableHashTable;
    for sigma in coneList do (
        V := rayList_sigma;
        It := sub(I, matrix{ apply(n, i -> product(n, j -> Yr_j^(V#j#i))) });
        excHere := select(toList(0..n-1), a -> isExc V#a);
        St := saturate(It, product(excHere, a -> Yr_a));
        if St == ideal 1_Yr then continue;
        Jt := St + minors(codim St, jacobian St);
        if dim Jt >= 0 then (allSmooth = false; badCharts = append(badCharts, (sigma, St, dim Jt)));
        for a in excHere do if dim(St + ideal Yr_a) >= 0 then excMeet#(sigma#a) = true);
    << "strict transform smooth in all charts : " << allSmooth << endl;
    for b in badCharts do << "  singular chart " << b#0 << "  Sing dim " << b#2 << "  ideal " << b#1 << endl;
    << "exceptional divisors meeting the strict transform: " << #keys excMeet << "  rays " << apply(sort keys excMeet, j -> rayList#j) << endl;
    new HashTable from {"allSmooth" => allSmooth, "charts" => #coneList, "meets" => sort keys excMeet})

-- ---------------------------------------------------------------- properness check
-- X~ -> X is proper because X~ is closed in the toric variety T and T -> A^n is proper.
-- T -> A^n is proper exactly when the fan of T REFINES the orthant fan, i.e. has the same
-- support (Cox-Little-Schenck Thm 3.4.11).  We verify the support condition directly:
--   (a) every ray of T lies in the closed positive orthant;
--   (b) each standard basis vector e_i is a ray of T (so all proper faces of the orthant survive);
--   (c) a random rational point in the interior of the orthant lies in exactly one maximal cone.
-- (c) is a Monte Carlo test of "the maximal cones tile the orthant".
-- SUPERSEDED by refinesOrthantExact below, and kept only as the record of the first approach.
-- It samples random interior points and asks whether some maximal cone contains each.  A point
-- covered more than once is counted as "benign", but that is exactly what overlapping full
-- dimensional cones look like, so this test cannot see the failure it is named for.
checkRefinesOrthant = method(Options => {Trials => 40, Verbose => true});
checkRefinesOrthant (List, List) := opts -> (rayList, coneList) -> (
    n := #(rayList#0);
    inOrthant := all(rayList, u -> all(u, c -> c >= 0));
    basisVecs := entries id_(ZZ^n);
    hasBasis := all(basisVecs, e -> member(e, rayList));
    setRandomSeed 1;
    badTrials := 0; onFace := 0;
    for t from 1 to opts.Trials do (
        q := apply(n, i -> 1 + random 97);
        cnt := 0;
        for sigma in coneList do (
            U := transpose matrix apply(sigma, i -> rayList#i);
            lam := flatten entries solve(promote(U, QQ), transpose promote(matrix {q}, QQ));
            if all(lam, x -> x >= 0) then cnt = cnt + 1);
        if cnt == 0 then badTrials = badTrials + 1
        else if cnt > 1 then onFace = onFace + 1);
    ok := inOrthant and hasBasis and badTrials == 0;
    if opts.Verbose then
        << "fan refines the orthant: rays in orthant " << inOrthant << ", contains e_i " << hasBasis
           << ", interior points covered " << (opts.Trials - badTrials) << "/" << opts.Trials
           << " (" << onFace << " landed on a shared face, which is benign)"
           << "  =>  T -> A^n proper : " << ok << endl;
    ok);

-- ---------------------------------------------------------------- proof objects
-- (a) EXACT refinement test, replacing the Monte Carlo one.  A simplicial fan whose rays lie in
-- the orthant refines the orthant fan iff every wall (codim-1 cone) lying in the boundary of the
-- orthant belongs to exactly one maximal cone, every other wall to exactly two, the dual graph is
-- connected, and every e_i is a ray.  All of this is finite integer combinatorics.
refinesOrthantExact = (rayList, coneList) -> (
    n := #(rayList#0);
    notes := {};
    -- Full dimensional means n *independent* rays.  Counting rays is not enough: a cone whose n
    -- generators are linearly dependent has determinant 0, spans a proper subspace, and would
    -- still pass the purely combinatorial wall count below.
    full := all(coneList, c -> #c == n and det matrix apply(c, i -> rayList#i) != 0);
    inOrth := all(rayList, u -> all(u, c -> c >= 0));
    hasBasis := all(entries id_(ZZ^n), e -> member(e, rayList));
    walls := unique flatten apply(coneList, c -> apply(#c, i -> drop(c, {i,i})));
    badBd := 0; badInt := 0; nBd := 0; nInt := 0;
    for tau in walls do (
        cnt := #select(coneList, c -> isSubset(tau, c));
        onBd := any(n, j -> all(tau, i -> (rayList#i)#j == 0));
        if onBd then (nBd = nBd + 1; if cnt != 1 then badBd = badBd + 1)
        else (nInt = nInt + 1; if cnt != 2 then badInt = badInt + 1));
    -- connectivity of the dual graph
    seen := new MutableHashTable; seen#0 = true; frontier := {0};
    while #frontier > 0 do (
        cur := first frontier; frontier = drop(frontier, 1);
        for j from 0 to #coneList - 1 do
            if not seen#?j and #(set(coneList#cur) * set(coneList#j)) == n-1 then (seen#j = true; frontier = append(frontier, j)));
    conn := (#keys seen == #coneList);
    ok := full and inOrth and hasBasis and badBd == 0 and badInt == 0 and conn;
    (ok, {"maximal cones all of dimension n: " | toString full,
          "all rays in the closed orthant: " | toString inOrth,
          "every e_i is a ray: " | toString hasBasis,
          "boundary walls in exactly one maximal cone: " | toString nBd | " walls, " | toString badBd | " violations",
          "interior walls in exactly two maximal cones: " | toString nInt | " walls, " | toString badInt | " violations",
          "dual graph connected: " | toString conn}));

-- (b) A unit-ideal certificate: cofactors c with (generators) * c = 1.  Expanding this identity
-- proves the ideal is the unit ideal without trusting any Groebner engine.
unitCertificate = I -> (
    R := ring I;
    G := gens I;
    c := (matrix {{1_R}}) // G;
    if G * c != matrix {{1_R}} then null else c);
