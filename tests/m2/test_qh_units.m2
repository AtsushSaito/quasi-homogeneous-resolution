-- Unit tests of the research library src/qh.m2: small building blocks with known answers,
-- degenerate inputs and error handling.
--   M2 --script tests/m2/test_qh_units.m2        (about 30 s)
load(currentFileDirectory | "../../src/qh.m2")
fails = thunk -> (try (thunk(); false) else true);
count = 0;
ok = (label, cond) -> (count = count + 1; if not cond then (<< "FAILED: " << label << endl; exit 1));

-- ---------------------------------------------------------------- Hirzebruch-Jung (research version)
ok("hjChain 5/2", hjChain(5,2) == {3,2});
ok("hjChain 7/3", hjChain(7,3) == {3,2,2});
ok("hjChain r/1", all(2..9, r -> hjChain(r,1) == {r}));
ok("hjChain r/(r-1)", all(2..9, r -> hjChain(r,r-1) == toList((r-1):2)));

-- ---------------------------------------------------------------- invariants of mu_r (valid for p | r)
for c in {(2, 2, {1,1}), (3, 3, {1,2}), (2, 4, {1,3}), (5, 5, {1,2,3}), (3, 3, {1,1,2})} do (
    (p, r, wts) := c;
    A := (ZZ/p)[apply(#wts, j -> (getSymbol "t")_j)];
    inv := muInvariantMonomials(wts, r, A);
    ok("invariant monomials have weight 0 mod r " | toString c,
       all(inv, g -> (e := first exponents g; sum(#wts, j -> wts#j * e#j) % r == 0)));
    ok("invariant monomials are minimal " | toString c,
       all(inv, g -> all(inv, h -> g == h or g % h != 0)));
    ok("every t_j^r is an invariant, so is in the ideal generated by the invariants " | toString c,
       all(gens A, t -> any(inv, g -> t^r % g == 0))));
-- 1/2(1,1) = cone over the Veronese conic: invariants t0^2, t0 t1, t1^2, in every characteristic
for p in {2,3,5} do (
    A := (ZZ/p)[a,b];
    ok("A_1 invariants in char " | toString p, #muInvariantMonomials({1,1}, 2, A) == 3));
ok("1/3(1,2) = A_2 has 3 invariants", #muInvariantMonomials({1,2}, 3, (ZZ/3)[a,b]) == 3);

-- ---------------------------------------------------------------- reduction to the normal form 1/r(1,q)
ok("pseudo-reflection group of 1/2(1,0) has order 2", reflectionSubgroupOrder(2, {1,0}) == 2);
ok("1/2(1,1) has no pseudo-reflection", reflectionSubgroupOrder(2, {1,1}) == 1);

-- ---------------------------------------------------------------- Newton polyhedron: initial forms
R = QQ[x,y,z];
f = x^2*y + y^2*z + z^2*x;
ok("x^2y+y^2z+z^2x has 7 initial forms (3 vertices, 3 edges, the face)", #initialForms f == 7);
ok("monomial: one initial form", initialForms(x*y*z) == {x*y*z});
ok("x^2+y^2+z^2: 7 initial forms", #initialForms(x^2+y^2+z^2) == 7);
ok("the full polynomial is among its initial forms", member(f, initialForms f));
ok("every initial form is a sub-sum of the terms of f",
   all(initialForms f, g -> (lf := set apply(listForm f, t -> t#0); all(listForm g, t -> lf#?(t#0)))));

-- ---------------------------------------------------------------- hypothesis checks and error handling
R2 = ZZ/2[x,y,z];
ok("non-quasi-homogeneous f is refused", fails(() -> qhReport(z^2 + x^3 + y^5, {1,1,1})));
rep = qhReport(z^2 + x^3 + y^5, {10,6,15});
ok("E8, char 2: A4", rep#"A4");
ok("E8, char 2: strata orders", sort apply(rep#"strata", s -> s#"r") == {2,3,5});
ok("E8, char 2: degree", rep#"d" == 30);
ok("E8, char 2: Newton non-degenerate", rep#"nondegenerate");
R3 = ZZ/3[x,y,z];
rep3 = qhReport(x^3 + y^3 + z^3, {1,1,1});      -- (x+y+z)^3 in characteristic 3
ok("x^3+y^3+z^3 in char 3 is not isolated", not rep3#"A4");
ok("qhVerify returns SKIP when A4 fails", (qhVerify(x^3 + y^3 + z^3, {1,1,1}))#"verdict" == "SKIP");
R5 = ZZ/5[x,y,z];
ok("x^3+y^3+z^3 in char 5 is isolated", (qhReport(x^3 + y^3 + z^3, {1,1,1}))#"A4");
-- convenience
ok("x y + z^2 is not convenient (no pure power of x)", not (qhReport(x*y + z^2, {1,1,1}))#"convenient");

-- ---------------------------------------------------------------- exact properness test of a fan
orth = {{1,0},{0,1}};
(good, notes) = refinesOrthantExact(orth, {{0,1}});
ok("the orthant refines itself", good);
newRays = {{1,0},{1,1},{0,1}};
(good, notes) = refinesOrthantExact(newRays, {{0,1},{1,2}});
ok("the subdivision by (1,1) refines the orthant", good);
(bad, notes) = refinesOrthantExact(newRays, {{0,1}});
ok("a missing cone is detected", not bad);
(bad, notes) = refinesOrthantExact({{1,0},{0,1},{-1,1}}, {{0,2},{1,2}});
ok("a ray outside the orthant is detected", not bad);
(bad, notes) = refinesOrthantExact({{1,0},{1,1}}, {{0,1}});
ok("a fan without e_2 is detected", not bad);
(bad, notes) = refinesOrthantExact({{1,0},{0,1},{1,1}}, {{0,2},{1,2},{0,1}});
ok("overlapping cones are detected", not bad);
-- the smooth toric blow-up fans used for the weighted blow-ups: all pass
for wts in {{1,1,1},{1,2,3},{2,3,5},{10,6,15},{3,3,2,1},{2,2,2,1}} do (
    n := #wts;
    T := makeSmooth toricBlowup(toList(0..n-1), affineSpace n, wts);
    (good, notes) = refinesOrthantExact(rays T, max T);
    ok("blow-up fan refines the orthant " | toString wts, good and isSmooth T));

<< "qh unit tests: " << count << " checks passed" << endl;
